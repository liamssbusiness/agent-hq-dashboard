# ─────────────────────────────────────────────────────────────
# Alfred Brain — environment config
# Copy to `.env` and fill in. Nothing here is committed.
# ─────────────────────────────────────────────────────────────

# --- Model provider (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-PASTE_YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tiered models: cheap one for routine turns, strong one for hard work.
ALFRED_MODEL_CHEAP=deepseek/deepseek-v4-flash
ALFRED_MODEL_STRONG=anthropic/claude-opus-4-8
ALFRED_MODEL_EMBED=openai/text-embedding-3-small

# --- Budget guard (USD) ---
# Alfred tracks spend in the memory DB and refuses the STRONG model once
# the month's spend crosses the cap (cheap model still allowed).
ALFRED_MONTHLY_BUDGET_USD=100
ALFRED_STRONG_BUDGET_FRACTION=0.7   # reserve 70% of budget for strong-model work

# --- Access control ---
# A shared secret the web UI / your devices send as `Authorization: Bearer <token>`.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
ALFRED_ACCESS_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# --- Storage ---
ALFRED_DB_PATH=./alfred_memory.db

# --- Identity ---
ALFRED_OWNER_NAME=Liam
ALFRED_TIMEZONE=America/New_York

# --- Device mesh (filled in on July 16 once Tailscale is up) ---
# Comma-separated Tailscale URLs of your device agents, e.g.
# DEVICE_AGENTS=http://pc.tail-scale.ts.net:8765,http://macstudio.tail-scale.ts.net:8765
DEVICE_AGENTS=
DEVICE_AGENT_TOKEN=CHANGE_ME_SHARED_WITH_DEVICE_AGENTS
