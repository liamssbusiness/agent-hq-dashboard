# ─────────────────────────────────────────────────────────────
# Hermes → OpenRouter config
# Goal: run Alfred on the cheapest-but-capable OpenRouter model.
#
# HOW TO USE:
#   1. Copy this file next to your Hermes config and rename it to `.env`
#      (or copy these three values into Hermes's existing config file).
#   2. Paste your real OpenRouter key where it says PASTE_YOUR_KEY_HERE.
#   3. Save, then restart Hermes.
#
# NOTE: field NAMES depend on your Hermes build. Most agents use the
# OpenAI-compatible client, so these three names are the common ones.
# If Hermes uses different names, keep the VALUES and rename the keys.
# ─────────────────────────────────────────────────────────────

# Point the OpenAI-compatible client at OpenRouter instead of OpenAI
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Your OpenRouter key — starts with sk-or-  (get it at https://openrouter.ai/keys)
OPENAI_API_KEY=PASTE_YOUR_KEY_HERE

# The model Alfred runs on. Cheapest-but-capable pick for agents (verified Jun 2026):
#   deepseek/deepseek-v4-flash   ~$0.14/M in, $0.28/M out, 1M context, tuned for agents
# Alternatives if you want them later:
#   deepseek/deepseek-v4-pro     (smarter, pricier — for hard reasoning)
#   google/gemini-2.0-flash-001  (fast, cheap, reliable tool-calling)
MODEL=deepseek/deepseek-v4-flash

# Some Hermes builds read OPENROUTER_API_KEY instead — set both to be safe.
OPENROUTER_API_KEY=PASTE_YOUR_KEY_HERE
